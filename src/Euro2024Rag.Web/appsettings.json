{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ai": {
    "Provider": "Gemini",
    "EmbeddingProvider": "",
    "Resilience": {
      "MaxRetryAttempts": 2,
      "BaseDelay": "00:00:01",
      "AttemptTimeout": "00:00:15"
    },
    "Gemini": {
      "ApiKey": "",
      "ChatModels": [
        "gemini-3.8-flash",
        "gemini-3.5-flash",
        "gemini-3.7-flash",
        "gemini-3.6-flash"
      ],
      "RewriteModels": [
        "gemini-3.5-flash-lite",
        "gemini-3.1-flash-lite"
      ],
      "EmbeddingModel": "gemini-embedding-001"
    },
    "OpenAI": {
      "ApiKey": "",
      "Endpoint": "",
      "ChatModels": [
        "gpt-5.4-mini",
        "gpt-4.1-mini"
      ],
      "RewriteModels": [
        "gpt-5.4-nano",
        "gpt-4.1-nano"
      ],
      "EmbeddingModel": "text-embedding-3-small",
      "SupportsTemperature": false
    },
    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "ChatModels": [
        "gemma3:4b"
      ],
      "RewriteModels": [],
      "EmbeddingModel": "embeddinggemma",
      "DocumentPrefix": "title: none | text: ",
      "QueryPrefix": "task: search result | query: ",
      "EmbeddingBatchSize": 5,
      "AttemptTimeout": "00:01:30"
    }
  },
  "VectorStore": {
    "Provider": "InMemory",
    "CollectionName": "euro2024",
    "PgVector": {
      "ConnectionString": "Host=localhost;Port=5432;Username=postgres;Password=postgres;Database=euro2024",
      "Schema": "public"
    },
    "Qdrant": {
      "Host": "localhost",
      "Port": 6334,
      "Https": false,
      "ApiKey": ""
    },
    "Chroma": {
      "Endpoint": "http://localhost:8000",
      "Tenant": "default_tenant",
      "Database": "default_database"
    }
  },
  "Rag": {
    "DataFile": "Data/Euro_2024_Matches.csv",
    "ContextFile": "Data/tournament-context.json",
    "EmbeddingCacheFile": "App_Data/embedding-cache.json",
    "TopK": 8,
    "MinScore": 0.5,
    "QueryRewrite": "FollowUps",
    "MaxHistoryMessages": 6,
    "EmbeddingBatchSize": 25
  }
}
