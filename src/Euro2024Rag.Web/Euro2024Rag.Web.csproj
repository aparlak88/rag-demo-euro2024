<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.VectorData.InMemory" Version="1.0.1" />
    <PackageReference Include="CommunityToolkit.VectorData.PgVector" Version="1.0.1" />
    <PackageReference Include="CommunityToolkit.VectorData.Qdrant" Version="1.0.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Google.GenAI" Version="1.22.0" />
    <PackageReference Include="Polly.Core" Version="8.8.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="Data\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
